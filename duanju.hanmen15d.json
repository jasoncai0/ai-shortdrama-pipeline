{
  "ports": {
    "llm": {
      "impl": "stub",
      "options": {
        "seed": "unused-import-script-needs-no-llm"
      }
    },
    "image": {
      "impl": "libtv",
      "options": {
        "model": "General image Pro",
        "canvas": "${LIBTV_PROJECT_UUID}"
      }
    },
    "video": {
      "impl": "libtv",
      "options": {
        "model": "Seedance 2.0 Mini",
        "canvas": "${LIBTV_PROJECT_UUID}",
        "resolution": "720p",
        "minSeconds": 4,
        "maxSeconds": 15
      }
    },
    "assetStore": {
      "impl": "localfs",
      "options": {
        "root": "./.hanmen15/assetStore"
      }
    },
    "state": {
      "impl": "localjson",
      "options": {
        "root": "./.hanmen15/state"
      }
    },
    "ledger": {
      "impl": "noop",
      "options": {}
    },
    "export": {
      "impl": "ffmpeg",
      "options": {
        "fps": 24,
        "crf": 20
      }
    },
    "promptStrategy": {
      "impl": "skill-anchored",
      "options": {
        "dir": "./prompts",
        "profileDir": "./prompts/profiles",
        "profile": "photoreal-drama"
      }
    },
    "speech": {
      "impl": "libtv",
      "options": {
        "canvas": "${LIBTV_PROJECT_UUID}",
        "model": "Minimax-speech-2.8-hd",
        "speed": 1
      }
    },
    "post": {
      "impl": "ffmpeg",
      "options": {}
    },
    "music": {
      "impl": "stub",
      "options": {}
    }
